OPENAI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yc_search

# Clerk auth (required once auth is enabled in prod; dev can run w/o, but sign-in won't work)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# optional:
# SYNC_TOKEN=your-shared-secret-for-api-sync
# SQLITE_IMPORT_PATH=./data/yc_search.sqlite
# SYNC_SCRAPE_LIMIT=25
# SYNC_EMBED_LIMIT=50
# SYNC_GITHUB_LIMIT=50
# SYNC_FOUNDER_SITE_CRAWL_LIMIT=50
# SYNC_EXA_LIMIT=20
# GITHUB_TOKEN=           # optional, bumps GitHub API from 60/hr to 5000/hr
# EXA_API_KEY=            # optional, enables founder mention enrichment via Exa
CRAWL4AI_PYTHON_BIN=.venv/bin/python
CRAWL4AI_PAGE_TIMEOUT_MS=35000

# Vendor worker (see docs/vendor-pipeline.md)
# VENDOR_DEDICATED_WORKER=1 # set on incremental sync only after the dedicated worker is running
# VENDOR_ENRICHMENT_CONCURRENCY=3
# VENDOR_PILOT_ID=initial-100 # optional production rollout cohort; remove to backfill all companies
# VENDOR_MAX_ATTEMPTS=4
# VENDOR_RETRY_SECONDS=60
# VENDOR_LEASE_SECONDS=300
# VENDOR_COMPANY_TIMEOUT_MS=180000
# VENDOR_REFRESH_DAYS=30
# VENDOR_DISCOVERY_URL_LIMIT=14
# VENDOR_BROWSER_FALLBACK_LIMIT=3
# VENDOR_EXA_FALLBACK=1
# VENDOR_VALIDATION_MODEL=gpt-4o-mini

# Company-list discovery: EXA_API_KEY enables automatic publisher/year searches.
# DATABASE_URL and OPENAI_API_KEY are shared with existing jobs.
COMPANY_DISCOVERY_MODEL=gpt-4o-mini

# Shared HTTP/browser transport (docs/scraping.md)
# SCRAPE_DOMAIN_DELAY_MS=1000
# SCRAPE_BROWSER_WORKERS=2
# Opt-in residential fallback: domain allowlist and proxy credentials required.
SCRAPE_PROXY_ENABLED=0
# SCRAPE_PROXY_URL=http://USERNAME:PASSWORD@PROXY_HOST:PORT
# SCRAPE_PROXY_DOMAINS=linkedin.com,example.com
# SCRAPE_PROXY_MONTHLY_USD=10
# SCRAPE_PROXY_USD_PER_GB=4
# SCRAPE_PROXY_REQUEST_MB=10
# SCRAPE_COMPARE_TIMEOUT_MS=20000

# Product analytics (public project key, not a personal API key). Omit to disable.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
